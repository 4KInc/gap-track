{
  "plugins": [
    "@typescript-eslint",
    "@amazon-devices/eslint-plugin-kepler"
  ],
  "extends": [
    "@react-native",
    "eslint:recommended",
    "plugin:@amazon-devices/eslint-plugin-kepler/kepler"
  ],
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    },
    {
      "files": [
        "package.json",
        "kepler-compatibility.json"
      ],
      "parser": "jsonc-eslint-parser"
    },
    {
      "files": [
        "pipeline/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts"
      ],
      "env": {
        "node": true,
        "jest": true
      }
    }
  ],
  "ignorePatterns": [
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "package-lock.json",
    "src/w3cmedia/shakaplayer/**",
    "src/w3cmedia/polyfills/**"
  ]
}
